generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Benutzer & Sessions ─────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("TECHNIKER") // ADMIN | TECHNIKER | HELFER
  approved     Boolean  @default(false)
  createdAt    DateTime @default(now())

  sessions           Session[]
  logs               ActivityLog[]
  issues             Issue[]
  photos             Photo[]
  feedbacks          Feedback[]
  maintenanceRecords MaintenanceRecord[]
  mission            ActiveMission?
  bulkMovements      BulkMovement[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Standorte ───────────────────────────────────────────────────────

model Location {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  lat         Float?
  lng         Float?

  devices   Device[]
  cases     Case[]
  bulkItems BulkItem[]
}

// ── Geräte & Cases ──────────────────────────────────────────────────

model Device {
  id            String    @id @default(cuid())
  inventoryNo   String    @unique
  name          String
  category      String?
  serialNo      String?
  purchaseDate  DateTime?
  purchasePrice Float?
  supplier      String?
  weightKg      Float?
  notes         String?
  status        String    @default("EINSATZBEREIT") // EINSATZBEREIT | DEFEKT_GEMELDET | GESPERRT | IN_REPARATUR | AUSGEMUSTERT
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id], onDelete: SetNull)

  // "zuletzt gesehen" per GPS beim Scan
  lastLat    Float?
  lastLng    Float?
  lastSeenAt DateTime?

  // Zusatzfelder: null = Kategorie-Standard gilt, sonst JSON-Array eigener Feld-Codes
  fieldOverride String?

  photos       Photo[]
  issues       Issue[]
  maintenances MaintenancePlan[]
  eventItems   EventItem[]
  logs         ActivityLog[]
  fieldValues  DeviceFieldValue[]
  rigFixtures  RigFixture[]
}

model Case {
  id          String  @id @default(cuid())
  inventoryNo String  @unique
  name        String
  description String?

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  devices Device[]
}

// ── Veranstaltungen & Packlisten ────────────────────────────────────

model Event {
  id        String   @id @default(cuid())
  name      String
  venue     String?
  startDate DateTime
  endDate   DateTime
  notes     String?
  planImage String? // Dateiname des hochgeladenen Veranstaltungsplans
  createdAt DateTime @default(now())

  items       EventItem[]
  logs        ActivityLog[]
  rigFixtures RigFixture[]
  missions    ActiveMission[]
  bulkMovements BulkMovement[]
}

model EventItem {
  id       String  @id @default(cuid())
  eventId  String
  deviceId String
  position String? // Einsatzposition als Text, z. B. "Bühne links"
  status   String  @default("GEPLANT") // GEPLANT | GEPACKT | AUFGEBAUT | ABGEBAUT | ZURUECK

  // Position auf dem Veranstaltungsplan (relativ 0..1, per Drag & Drop)
  planX Float?
  planY Float?

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([eventId, deviceId])
}

// ── Wartung ─────────────────────────────────────────────────────────

model MaintenancePlan {
  id             String    @id @default(cuid())
  deviceId       String
  title          String // z. B. "DGUV V3-Prüfung"
  intervalMonths Int
  // Stichtag für die Fälligkeitsberechnung. Wird aus den Prüfungen unten
  // abgeleitet: eine durchgefallene Prüfung schiebt ihn NICHT weiter, das
  // Gerät bleibt fällig, bis es die Prüfung besteht.
  lastDoneAt     DateTime?
  notes          String?

  device  Device              @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  records MaintenanceRecord[]
}

/// Eine einzelne durchgeführte Prüfung — der eigentliche Nachweis.
/// Getrennt vom Plan, damit die Historie vollständig erhalten bleibt:
/// Wer hat wann mit welchem Ergebnis geprüft, und wo liegt das Protokoll.
model MaintenanceRecord {
  id          String   @id @default(cuid())
  planId      String
  performedAt DateTime
  result      String // BESTANDEN | MAENGEL | DURCHGEFALLEN
  testerName  String? // Prüfer, oft eine externe Person oder Firma
  notes       String?
  createdAt   DateTime @default(now())

  recordedById String // wer den Eintrag in OnTrack erfasst hat

  plan       MaintenancePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  recordedBy User            @relation(fields: [recordedById], references: [id])
  documents  Photo[]

  @@index([planId, performedAt])
}

// ── Fehlermeldungen (Defekt-Workflow) ───────────────────────────────

model Issue {
  id          String    @id @default(cuid())
  deviceId    String
  reporterId  String
  description String
  status      String    @default("OFFEN") // OFFEN | IN_REPARATUR | ERLEDIGT
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  device   Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  reporter User    @relation(fields: [reporterId], references: [id])
  photos   Photo[]
}

// ── Fotos ───────────────────────────────────────────────────────────

model Photo {
  id           String   @id @default(cuid())
  filename     String
  caption      String?
  createdAt    DateTime @default(now())
  uploadedById String

  deviceId            String?
  issueId             String?
  maintenanceRecordId String?

  device            Device?            @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  issue             Issue?             @relation(fields: [issueId], references: [id], onDelete: Cascade)
  maintenanceRecord MaintenanceRecord? @relation(fields: [maintenanceRecordId], references: [id], onDelete: Cascade)
  uploadedBy        User               @relation(fields: [uploadedById], references: [id])
}

// ── Historie ────────────────────────────────────────────────────────

model ActivityLog {
  id        String   @id @default(cuid())
  action    String // z. B. "Status geändert: einsatzbereit → gesperrt"
  details   String?
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())

  userId   String
  deviceId String?
  eventId  String?

  user   User    @relation(fields: [userId], references: [id])
  device Device? @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  event  Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

// ── App-Einstellungen (z. B. Fundmodus-Kontakt) ─────────────────────

model Setting {
  key   String @id
  value String
}

// ── Technische Zusatzfelder ──────────────────────────────────────────

/**
 * Pro Gerätekategorie festgelegte Auswahl aus dem Feldkatalog (JSON-Array von Codes).
 */
model CategoryFieldConfig {
  id         String @id @default(cuid())
  category   String @unique
  fieldCodes String // JSON-Array von Feld-Codes aus src/lib/fieldCatalog.ts
}

/**
 * Ein Freitext-Wert für ein Zusatzfeld an einem konkreten Gerät.
 */
model DeviceFieldValue {
  id        String @id @default(cuid())
  deviceId  String
  fieldCode String
  value     String

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, fieldCode])
}

// ── MVR-Rig-Import ────────────────────────────────────────────────────

/**
 * Eine Leuchte (Fixture) aus einer importierten MVR-Rig-Datei. installStatus/
 * actualPosition bilden Soll- (aus der MVR) vs. Ist-Montage ab: Wird auf der
 * Baustelle umdisponiert, wird hier festgehalten, wohin das Gerät tatsächlich
 * gewandert ist statt an die ursprünglich geplante Position.
 */
model RigFixture {
  id           String  @id @default(cuid())
  eventId      String
  uuid         String
  fixtureId    String?
  name         String
  gdtfSpec     String?
  gdtfMode     String?
  layerName    String?
  className    String?
  dmxAddresses String?
  posX         Float? // Meter (SOLL-Position aus der MVR)
  posY         Float?
  posZ         Float?
  deviceId     String?

  installStatus  String  @default("GEPLANT") // GEPLANT | MONTIERT | ABWEICHEND
  actualPosition String? // Freitext: tatsächliche Montageposition, nur bei ABWEICHEND

  createdAt DateTime @default(now())

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([eventId])
}

// ── Feedback (Kundentest) ────────────────────────────────────────────

/**
 * Freitext-Änderungswunsch, den ein Benutzer direkt von einer Seite aus meldet.
 */
model Feedback {
  id         String    @id @default(cuid())
  userId     String
  page       String
  message    String
  status     String    @default("OFFEN") // OFFEN | ERLEDIGT
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Einsatzmodus ────────────────────────────────────────────────────

/**
 * Der laufende Einsatz eines Benutzers: ein Event plus die Phase, in der
 * gerade gearbeitet wird. Solange er läuft, hakt ein Scan das Gerät direkt
 * ab, statt nur seine Detailseite zu öffnen.
 *
 * Bewusst je Benutzer und nicht global: Beim Abbau einer Veranstaltung kann
 * eine Person schon zurückräumen, während eine andere noch abbaut.
 */
model ActiveMission {
  id        String   @id @default(cuid())
  userId    String   @unique
  eventId   String
  /** Zielstatus der Phase: GEPACKT | AUFGEBAUT | ABGEBAUT | ZURUECK */
  phase     String
  startedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

// ── Mengenartikel ───────────────────────────────────────────────────

/**
 * Verbrauchs- und Kleinteile, die nach Stückzahl geführt werden.
 *
 * Kabel, Schellen, Klemmen, Gaffa: Ein eigener QR-Code je Stück wäre
 * unbrauchbar, und genau diese Dinge gehen verloren. Statt einzelner
 * Datensätze gibt es einen Bestand mit Bewegungen.
 */
model BulkItem {
  id          String   @id @default(cuid())
  name        String
  category    String?
  /** Einheit der Zählung: Stück, m, Rolle, Paar … */
  unit        String   @default("Stück")
  /** Aktueller Bestand. Wird nur über Bewegungen verändert. */
  quantity    Int      @default(0)
  /** Ab diesem Bestand wird gewarnt; null = keine Warnung. */
  minQuantity Int?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  movements BulkMovement[]

  @@unique([name, locationId])
}

/**
 * Jede Änderung am Bestand — Entnahme, Rückgabe, Zugang oder Korrektur.
 *
 * Der Bestand wird nie direkt gesetzt, sondern ergibt sich aus den
 * Bewegungen. Nur so lässt sich später beantworten, wohin die 40 Kabel
 * gegangen sind.
 */
model BulkMovement {
  id        String   @id @default(cuid())
  itemId    String
  /** Negativ = Entnahme, positiv = Rückgabe oder Zugang. */
  delta     Int
  /** ENTNAHME | RUECKGABE | ZUGANG | KORREKTUR */
  reason    String
  note      String?
  createdAt DateTime @default(now())

  userId  String
  eventId String?

  item  BulkItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user  User     @relation(fields: [userId], references: [id])
  event Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
}
