# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
# Hinweis: /build wird NICHT ignoriert — dort liegen die Bau-Ressourcen
# des Desktop-Pakets (Icon, after-pack.js). Die Build-Ausgabe liegt in
# .next/ und /release.

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OnTrack: Laufzeitdaten nie committen
prisma/data/
data/
.claude/settings.local.json
.claude/worktrees/
*.mvr

# Desktop-Builds (Installer werden über GitHub Releases verteilt)
/release
